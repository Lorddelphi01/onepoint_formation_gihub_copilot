[248.995454, "o", "\u001b[?2026h\u001b[?25l\u001b[3;44r\u001b[44;1H\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[1;51r\u001b[20;209H\u001b[38;2;145;152;161m┃\r\r\n\u001b[208C┃\r\r\n\u001b[208C┃\r\r\n\u001b[208C┃\r\r\n\u001b[208C┃\r\r\n\u001b[208C┃\r\r\n\u001b[208C┃\r\r\n\u001b[208C┃\r\r\n\u001b[208C┃\r\r\n\u001b[208C┃\r\r\n\u001b[208C┃\r\u001b[36;4H\u001b[38;5;116m- ID ;\u001b[199C\u001b[38;2;240;246;252m┃\r\r\n\u001b[3C\u001b[38;5;116m- question ;\u001b[193C\u001b[38;2;240;246;252m┃\r\r\n\u001b[3C\u001b[38;5;116m- impact si non résolue ;\u001b[180C\u001b[38;2;240;246;252m┃\r\r\n\u001b[3C\u001b[38;5;116m- hypothèse actuellement retenue ;\u001b[171C\u001b[38;2;240;246;252m┃\r\r\n\u001b[3C\u001b[38;5;116m- décision attendue de ma part ;\u001b[173C\u001b[38;2;240;246;252m┃\r\r\n\u001b[3C\u001b[38;5;116m- bloquante pour coder : oui/non ;\u001b[171C\u001b[38;2;240;246;252m┃\r\r\n\u001b[3C\u001b[38;5;116m- fichier concerné.\u001b[186C\u001b[38;2;240;246;252m┃\r\r\n\u001b[208C┃\r\r\n\u001b[3C\u001b[38;5;116mRegroupe les questions similaires, ne répète pas celles déjà décidées\u001b[136C\u001b[38;2;240;246;252m┃\r\u001b[50;2H\u001b[38;2;68;147;248m◉\u001b[m \u001b[?2026l\u001b[2A\b\u001b[?25h"]
