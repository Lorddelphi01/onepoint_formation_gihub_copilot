[316.272852, "o", "\u001b[?2026h\u001b[?25l\u001b[42;46r\u001b[46;1H\r\n\r\n\u001b[1;51r\u001b[41;7H\u001b[4;38;2;240;246;252;48;2;20;27;34mx\u001b[24mit\u001b[41;41HExit the CLI; use 'print' to print the session after exiting alt screen\u001b[0;48;2;20;27;34m\u001b[K\r\n\u001b[0;38;2;68;147;248m┃\u001b[5C\u001b[4;38;2;240;246;252mx\r\n\u001b[0;38;2;68;147;248m┃\u001b[5C\u001b[4;38;2;240;246;252mx\r\n\u001b[0;38;2;68;147;248m┃\u001b[5C\u001b[4;38;2;240;246;252mx\r\n\u001b[0;38;2;68;147;248m┃\u001b[m \u001b[38;2;240;246;252m  /\u001b[4mex\u001b[24mtract\u001b[45;41H\u001b[38;2;145;152;161mExtract and consolidate reusable components, design tokens, and patterns into your design system. Identifies opportunities for systematic reuse and enriches your compon…\r\r\n┃\u001b[m \u001b[38;2;240;246;252m  /cont\u001b[4mex\u001b[24mt\u001b[46;41H\u001b[38;2;145;152;161mShow context window token usage and visualization\r\n\r\n\u001b[4C\u001b[0;48;2;20;27;34mx\u001b[38;2;145;152;161mit \u001b[m\u001b[?2026l\b\b\b\u001b[?25h"]
[316.665559, "o", "\u001b[?2026h\u001b[?25l\u001b[41;8H\u001b[4;38;2;240;246;252;48;2;20;27;34mi\u001b[24mt\r\n\u001b[10C\u001b[4;49mi\u001b[24mm\u001b[B\b\u001b[4mi\u001b[24mo\r\n\u001b[5Canalyse-technique-us\u001b[44;41H\u001b[38;2;145;152;161mTransforme une User Story Jira en analyse technique complète et détaillée (synthèse, critères d'acceptation, impact sur le code \u001b[4mexi\u001b[24mstant, architecture, modifications à …\r\r\n\u001b[5C\u001b[38;2;240;246;252mretroconception-uml\u001b[45;41H\u001b[38;2;145;152;161mRétroconçoit le fonctionnement technique et fonctionnel d'un projet \u001b[4mexi\u001b[24mstant (règles de gestion, architecture, processus métier) et produit une documentation UML (Merma\r\n\u001b[5C\u001b[38;2;240;246;252mdistill\u001b[46;42H\u001b[38;2;145;152;161mtrip designs to their essence by removing unnecessary compl\u001b[4mexi\u001b[24mty. Great design is simple, powerful, and clean. Use when the user asks to simplify, declutter, reduce no…\r\r\n\r\n\u001b[5C\u001b[0;48;2;20;27;34mi\u001b[38;2;145;152;161mt\u001b[m\u001b[?2026l\b\u001b[?25h"]
