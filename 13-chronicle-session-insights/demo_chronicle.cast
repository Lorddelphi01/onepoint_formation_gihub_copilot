[315.539356, "o", "\u001b[?2026h\u001b[?25l\u001b[3;45r\u001b[45;1H\r\n\r\n\r\n\r\n\r\n\u001b[1;51r\u001b[30;209H\u001b[38;2;145;152;161m┃\r\r\n\u001b[208C┃\r\r\n\u001b[208C┃\r\u001b[9B\u001b[38;2;68;147;248;48;2;20;27;34m┃\u001b[39m \u001b[38;2;240;246;252m❯ /add-dir\u001b[0;48;2;20;27;34m                            \u001b[38;2;240;246;252;48;2;20;27;34mAllow file access to a directory and load its .github skills and agents as trusted configuration\u001b[0;48;2;20;27;34m\u001b[K\r\n\u001b[0;38;2;145;152;161m┃\u001b[m \u001b[38;2;240;246;252m  /after\u001b[42;41H\u001b[38;2;145;152;161mSchedule a one-shot prompt, skill, or schedulable slash command for this session (e.g. /after 30s ping me, /after 10m /tuikit-new, /after 1h /chronicle standup)\u001b[38;2;249;241;165m (experi…\r\r\n\u001b[38;2;145;152;161m┃\u001b[m \u001b[38;2;240;246;252m  /agent\u001b[43;41H\u001b[38;2;145;152;161mBrowse and select agents: /agent [name]\r\n┃\u001b[m \u001b[38;2;240;246;252m  /allow-all\u001b[44;41H\u001b[38;2;145;152;161mEnable all permissions (tools, paths, and URLs)\r\n┃\u001b[m \u001b[38;2;240;246;252m  /app\u001b[45;41H\u001b[38;2;145;152;161mPrefer a visual workspace? Try out the GitHub Copilot desktop app\r\n┃\u001b[m \u001b[38;2;240;246;252m  /ask\u001b[m                                \u001b[38;2;145;152;161mAsk a quick side question without adding to conversation history\u001b[m\u001b[K\r\n\r\n\u001b[2C\u001b[48;2;20;27;34m/\u001b[38;2;145;152;161madd-dir \r\n\r\n\u001b[C\u001b[1;49m/help\u001b[22m show help\u001b[m                                    \u001b[?2026l\u001b[48;4H\u001b[?25h"]
