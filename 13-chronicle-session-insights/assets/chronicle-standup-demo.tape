# 13-chronicle-session-insights: /chronicle standup
# Remplace la version actuelle du GIF, qui est une illustration fabriquée
# ("Sortie anonymisée" écrit en légende, pas une vraie sortie capturée).
# Prérequis : nécessite un minimum d'historique Copilot CLI local pour produire
# un résultat non vide (idéalement après avoir suivi les chapitres précédents).

Output chronicle-standup-demo.gif

Set FontSize 18
Set Width 1000
Set Height 600
Set Theme "Dracula"
Set Padding 20
Set BorderRadius 8
Set Margin 10
Set MarginFill "#282a36"
Set Framerate 10
Set TypingSpeed 60ms

Type "copilot"
Enter
Sleep 5s

Type "/chronicle standup for the last 3 days"
Sleep 1s
Enter
Sleep 3s
Hide
Type " "
Backspace
Show
Sleep 3s
Hide
Type " "
Backspace
Show
Sleep 3s
Hide
Type " "
Backspace
Show
Sleep 2s

Ctrl+C
Sleep 1s
