# 13-chronicle-session-insights: /chronicle improve
# Répond "n" à l'invite finale ("Apply selected suggestions... [y/N]") pour ne
# jamais modifier .github/copilot-instructions.md pendant l'enregistrement.

Output chronicle-improve-demo.gif

Set FontSize 18
Set Width 1000
Set Height 600
Set Theme "Dracula"
Set Padding 20
Set BorderRadius 8
Set Margin 10
Set MarginFill "#282a36"
Set Framerate 10
Set TypingSpeed 60ms

Type "copilot"
Enter
Sleep 5s

Type "/chronicle improve"
Sleep 1s
Enter
Sleep 3s
Hide
Type " "
Backspace
Show
Sleep 3s
Hide
Type " "
Backspace
Show
Sleep 2s

Type "n"
Enter
Sleep 1s

Ctrl+C
Sleep 1s
