# Chapitre 09 : ouverture du dev container
Output devcontainer-demo.gif

Set FontSize 18
Set Width 1000
Set Height 600
Set Theme "Dracula"
Set Padding 20
Set BorderRadius 8
Set Margin 10
Set MarginFill "#282a36"
Set Framerate 10
Set TypingSpeed 45ms

Type "printf '\033[1;36mDEV CONTAINER\033[0m\nVS Code > Dev Containers: Reopen in Container\n\n$ copilot --version\nGitHub Copilot CLI 1.x\n$ cd samples/book-app-project && python book_app.py help\nUsage: python book_app.py <command>\n\n✓ Python, pytest, GitHub CLI et Copilot CLI sont prêts.'"
Enter
Sleep 6s
